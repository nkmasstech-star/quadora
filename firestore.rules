rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'nkmasstech@gmail.com'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function stepsBy1(f) { return request.resource.data[f] - resource.data[f] in [-1, 1]; }

    // manual results typed on the admin page: everyone reads, only the owner writes
    match /pub/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // players: public name + avatar; only the player edits them; the follower counter moves by 1 at a time
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'followers', 'created'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 25
        && request.resource.data.followers == 0;
      allow update: if signedIn() && ((request.auth.uid == uid && onlyChanges(['name', 'avatar']) && request.resource.data.name.size() <= 25)
        || (request.auth.uid == uid && onlyChanges(['shares']) && request.resource.data.shares == resource.data.get('shares', 0) + 1)
        // invite: the new player names their inviter once...
        || (request.auth.uid == uid && onlyChanges(['refBy']) && !('refBy' in resource.data) && request.resource.data.refBy is string && request.resource.data.refBy != uid)
        // ...and adds 1 to the inviter's count, together with refs/{newPlayer} (once)
        || (request.auth.uid != uid && onlyChanges(['refs']) && request.resource.data.refs == resource.data.get('refs', 0) + 1
            && !exists(/databases/$(database)/documents/users/$(uid)/refs/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/users/$(uid)/refs/$(request.auth.uid)))
        || (onlyChanges(['followers']) && stepsBy1('followers')));
      allow delete: if signedIn() && request.auth.uid == uid || isAdmin();
      match /likes/{pid} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /following/{tid} { allow read, write: if signedIn() && request.auth.uid == uid; }
      // notifications: another signed-in player adds one item in their own name (id type_theirUid_post, never edited by them);
      // only the owner reads them, marks them read or deletes them
      match /gfollow/{gid} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /refs/{rid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && rid == request.auth.uid && rid != uid
          && !('refBy' in get(/databases/$(database)/documents/users/$(rid)).data)
          && getAfter(/databases/$(database)/documents/users/$(rid)).data.refBy == uid;
      }
      match /inbox/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && onlyChanges(['read']);
        allow create: if signedIn() && request.auth.uid != uid
          && request.resource.data.keys().hasOnly(['type', 'from', 'fromUid', 'postId', 'at', 'read'])
          && request.resource.data.type in ['like', 'share', 'follow', 'challenge', 'group']
          && request.resource.data.fromUid == request.auth.uid
          && nid.matches('^[a-z]+_' + request.auth.uid + '_[A-Za-z0-9]+$')
          && request.resource.data.from is string && request.resource.data.from.size() <= 25
          && request.resource.data.read == false;
      }
    }

    // posts: anyone reads; the owner creates/edits/deletes; likes and reports move their counters by 1
    match /posts/{pid} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.picks.size() <= 2 && request.resource.data.up == 0 && request.resource.data.reports == 0
        // a post in a public group: only by a member of that group
        && (!('gid' in request.resource.data) || request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.members);
      allow update: if signedIn() && ((resource.data.uid == request.auth.uid && onlyChanges(['picks', 'edited']))
        || (onlyChanges(['up']) && stepsBy1('up'))
        || (onlyChanges(['reports']) && request.resource.data.reports == resource.data.reports + 1)
        || (isAdmin() && onlyChanges(['reports']) && request.resource.data.reports == 0));
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // one report per player per post (create only, never edited)
      match /reports/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // groups: the doc id is the 6-letter join code. Anyone signed in can open one by its code; only members list
    // their groups. The admin (owner) renames, changes the icon, adds/removes members and deletes the group;
    // a player can add or remove only themself (join / leave). Max 50 members.
    match /groups/{gid} {
      function members() { return get(/databases/$(database)/documents/groups/$(gid)).data.members; }
      allow get: if signedIn();
      allow list: if signedIn() && (request.auth.uid in resource.data.members || resource.data.type == 'public');
      allow create: if signedIn() && gid.matches('^[A-Z0-9]{6}$') && request.resource.data.code == gid
        && request.resource.data.owner == request.auth.uid && request.resource.data.members == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['name', 'icon', 'type', 'owner', 'members', 'code', 'created'])
        && request.resource.data.type in ['public', 'private']
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30;
      allow update: if signedIn() && request.resource.data.members.size() <= 50 && (
        (resource.data.owner == request.auth.uid && onlyChanges(['name', 'icon', 'members'])
          && resource.data.owner in request.resource.data.members
          // public group: the admin can add but never remove anyone
          && (resource.data.get('type', 'private') != 'public' || request.resource.data.members.hasAll(resource.data.members))
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30)
        || (onlyChanges(['members']) && request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
        || (onlyChanges(['members']) && request.auth.uid != resource.data.owner
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
      match /challenges/{cid} {
        allow read: if signedIn() && request.auth.uid in members();
        allow create: if signedIn() && request.auth.uid in members() && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'byName', 'game', 'forDate', 'at']);
        allow delete: if signedIn() && (resource.data.by == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(gid)).data.owner == request.auth.uid);
      }
    }

    // poll: totals are public; a player adds one vote per game per draw, together with the 4 counters
    match /polls/{pid} {
      allow read: if true;
      allow create, update: if signedIn() && !exists(/databases/$(database)/documents/polls/$(pid)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/polls/$(pid)/votes/$(request.auth.uid));
      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.digits.matches('^[0-9]{4}$');
      }
    }
  }
}
