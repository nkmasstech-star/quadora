{
  "appId": "com.quadora.app",
  "appName": "Q Spot 4D",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": false,
      "launchFadeOutDuration": 0,
      "backgroundColor": "#000000"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#000000"
    },
    "FirebaseAuthentication": {
      "providers": [
        "google.com"
      ]
    }
  }
}