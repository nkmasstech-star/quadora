<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="450" android:duration="400" android:interpolator="@android:interpolator/overshoot"/>
    <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="450" android:duration="400" android:interpolator="@android:interpolator/overshoot"/>
    <objectAnimator android:propertyName="rotation" android:valueFrom="-90" android:valueTo="0" android:startOffset="450" android:duration="400" android:interpolator="@android:interpolator/fast_out_slow_in"/>
</set>
